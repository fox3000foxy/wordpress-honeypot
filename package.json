{
	"name": "wordpress-honeypot",
	"version": "1.0.0",
	"description": "Realistic WordPress honeypot for trapping scanners, bots, and AI agents",
	"repository": {
		"type": "git",
		"url": "https://github.com/fox3000foxy/wordpress-honeypot"
	},
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./express": {
			"types": "./dist/adapters/express.d.ts",
			"import": "./dist/adapters/express.js"
		},
		"./fastify": {
			"types": "./dist/adapters/fastify.d.ts",
			"import": "./dist/adapters/fastify.js"
		},
		"./hono": {
			"types": "./dist/adapters/hono.d.ts",
			"import": "./dist/adapters/hono.js"
		},
		"./koa": {
			"types": "./dist/adapters/koa.d.ts",
			"import": "./dist/adapters/koa.js"
		},
		"./node": {
			"types": "./dist/adapters/node-http.d.ts",
			"import": "./dist/adapters/node-http.js"
		}
	},
	"files": [
		"dist",
		"www",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"prepack": "npm run build",
		"build": "tsc --project tsconfig.json",
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"test": "vitest run",
		"dev": "vitest",
		"demo": "npx tsx demo.ts",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh"
	},
	"keywords": [
		"honeypot",
		"wordpress",
		"security",
		"deception",
		"bot-trap",
		"scanner"
	],
	"author": "Fox3000foxy",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^20.19.43",
		"eslint": "^10.2.1",
		"express": "^5.2.1",
		"globals": "^17.5.0",
		"tsx": "^4.23.5",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.58.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	}
}
